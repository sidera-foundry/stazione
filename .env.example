# Copy to .env.local for local development (npm run dev), or set these on your host (e.g. Vercel).
# In production generate the values with: npm run gen-secrets
DATABASE_URL=
PASSWORD_PEPPER=
DATA_ENCRYPTION_KEY=
INVITE_CODE=
MAX_USERS=2
# Self-hosted server only: HOST, PORT (default 0.0.0.0:3000), TRUST_PROXY=1 behind a reverse proxy, APP_ORIGIN=https://station.example.com
CRON_SECRET=
# Optional: time zone of the evening digest on Telegram (default UTC)
TIMEZONE=
# Optional: Telegram bot for approvals and notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
